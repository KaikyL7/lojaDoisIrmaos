# Copie este arquivo para ".env" e cole o endereço do seu banco PostgreSQL.
# O arquivo .env NÃO vai para o GitHub (ele contém a senha do banco).
#
# Neon (nuvem): painel do projeto > Connect > copie o endereço que começa com postgresql://
DATABASE_URL=postgresql://usuario:senha@endereco-do-banco.neon.tech/neondb?sslmode=require

# Porta do site (opcional)
PORT=3000
